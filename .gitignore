# ─────────────────────────────────────────────────────────────
# 비밀값이 담기는 파일 — 여기부터 본다.
# .env.swp 가 공개 저장소에 올라간 적이 있다(2026-08-29). 그때 배운 것:
# ignore 해야 할 것은 ".env" 라는 이름이 아니라 "그 내용이 흘러나갈 수 있는 모든 경로"다.
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.local

# 에디터가 파일을 열기만 해도 옆에 만드는 사본들.
# vim 은 .env 를 열면 .env.swp 에 내용을 통째로 복사해 둔다.
*.swp
*.swo
*.swn
.*.sw?
*~
.#*
\#*#
*.bak
*.orig
*.rej
*.tmp

# 키·인증서
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa*
id_ed25519*
.jira-token
*credentials*
*secrets*
!**/secrets.example*

# ─────────────────────────────────────────────────────────────
# 빌드 산출물 — 커밋하면 머지 충돌만 나고 쓸모가 없다
# ─────────────────────────────────────────────────────────────
node_modules/
dist/
build/
out/
.next/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

# ─────────────────────────────────────────────────────────────
# 실행 부산물
# ─────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
.npm/
.node_repl_history
*.tgz
coverage/
.nyc_output/
data/cache/
data/out/
.cache/

# ─────────────────────────────────────────────────────────────
# 에디터·OS
# ─────────────────────────────────────────────────────────────
.idea/
.vscode/
!.vscode/extensions.json
*.sublime-workspace
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# 문서는 별도 비공개 저장소다 (angyeongjin/eodi-docs).
# 기획·비즈니스·브랜드는 경쟁 정보라 코드와 같이 공개하지 않는다.
# 폴더는 여기 그대로 두고 `cd docs` 해서 따로 커밋한다.
docs/

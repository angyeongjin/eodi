# ────────────────────────────────────────────────
# 전부 선택 사항이다. 아무것도 없이도 서비스는 뜬다.
# (DB 가 없으면 캐시는 메모리, 인덱스 보강과 인기 검색어는 비활성)
# ────────────────────────────────────────────────

# ── DB 는 계정을 둘로 나눈다 ──────────────────────────────
# 앱은 런타임에 DML 만 한다. 오너 계정으로 붙여두면 구멍 하나에 스키마가 날아간다.
#
# [1] 운영관리용(오너) — 마이그레이션 전용. Vercel 에는 넣지 않는다.
DATABASE_URL_OWNER=
# [2] 서비스 연결용(앱) — `npm run db:setup-app-role` 이 자동으로 채운다.
#     이 값이 Vercel 의 DATABASE_URL 로 들어간다.
DATABASE_URL=
# 앱 전용 role 이름 (기본 eodi_app)
APP_ROLE=

# 사이트 절대 URL (사이트맵·OG 태그에 쓰인다)
NEXT_PUBLIC_SITE_URL=https://eodizzi.com

# 광고. 비워두면 광고 슬롯 자체가 렌더되지 않는다.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_INFEED_SLOT=

# 문의·게재중단 요청 접수 메일
NEXT_PUBLIC_CONTACT_EMAIL=hello@eodizzi.com

# 수집 정책
# 소스 kill switch — 게재 중단 요청을 받으면 여기에 넣으면 즉시 꺼진다
DISABLED_SOURCES=
# 봇 식별용 User-Agent (헤더에 들어가므로 ASCII 만).
# 도메인 연결 후에는 사이트의 수집 원칙 페이지를 가리키게 바꾼다.
# 예: EodizziBot/0.1 (+https://eodizzi.com/about; used-market meta search)
EODI_UA=
# 검색 결과 캐시 TTL (ms). 기본 10분
SEARCH_CACHE_TTL_MS=
# 소스당 제한 시간 (ms). 기본 4500. 넘으면 그 소스는 빼고 나머지로 응답한다
SOURCE_TIMEOUT_MS=
# 썸네일 표시 끄기
DISABLE_THUMBNAILS=
# 당근 기본 동네 slug (packages/crawler/data/daangn-regions.json 참고)
DEFAULT_REGION_SLUG=

# ── 키워드 알림 (웹 푸시) ───────────────────────
# `npm run vapid` 로 한 번 만들어 넣고 계속 쓴다.
# private 키가 유출되면 남이 우리 이름으로 푸시를 보낼 수 있으니 절대 커밋하지 말 것.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 발생 시 연락할 곳. mailto: 또는 https:
VAPID_SUBJECT=

# ── 일본 굿즈 수집 ─────────────────────────────
# 메루카리는 브라우저 렌더가 필요하다. 설치된 크롬 경로.
# (macOS 기본값이 코드에 있으므로 보통 비워둬도 된다. CI 에서는 지정 필요)
CHROME_PATH=
# 메루카리 키워드 사이 간격(ms). 기본 4000. 남의 서버에 몰아치지 않기 위한 값이니 줄이지 말 것.
MERCARI_GAP_MS=
